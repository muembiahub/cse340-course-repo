<%- include('../partials/header', { title }) %>

<main class="container my-5">
  <h1 class="mb-4 text-primary">
    <i class="fa-solid fa-user-shield me-2"></i> <%= title %>
  </h1>

  <!-- Current Admin Info -->
  <div class="alert alert-secondary mb-4">
    <i class="fa-solid fa-user me-2"></i> Logged in as: <strong><%= name %></strong> 
    (<%= role %>, <%= email %>)
  </div>

  <!-- User to Edit -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h5 class="card-title text-success">
        <i class="fa-solid fa-user-edit me-2"></i> Editing User: <%= userToEdit.name %>
      </h5>
      <p class="card-text"><i class="fa-solid fa-envelope me-2"></i>Email: <%= userToEdit.email %></p>
      <p class="card-text"><i class="fa-solid fa-id-badge me-2"></i>Current Role: <%= userToEdit.role_name %></p>
    </div>
  </div>

  <!-- Update Role Form -->
 <form action="/admin/users/<%= userToEdit.user_id %>/updateRole" method="POST" class="card shadow-sm p-4">
    <div class="mb-3">
      <label for="role" class="form-label fw-bold">
        <i class="fa-solid fa-user-tag me-2"></i>Select New Role
      </label>
      <select id="role" name="roleId" class="form-select" required>
        <% roles.forEach(r => { %>
          <option value="<%= r.role_id %>" <%= r.role_name === userToEdit.role_name ? 'selected' : '' %>>
            <%= r.role_name %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="d-flex justify-content-between">
      <a href="/admin/users" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Back
      </a>
      <button type="submit" class="btn btn-primary">
        <i class="fa-solid fa-save me-1"></i> Update Role
      </button>
    </div>
  </form>
</main>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<%- include('../partials/footer') %>
