<%- include('../partials/header') %>

<div class="container mt-4">
  <h2 class="mb-4"><%= title %></h2>

  <% if (volunteers?.length) { %>
    <table class="table table-striped table-hover shadow-sm">
      <thead class="table-primary">
        <tr>
          <th>Project</th>
          <th>Description</th>
          <th>Location</th>
          <th>Date</th>
          <th>Role Type</th>
          <th>Hours</th>
          <th>Start Date</th>
          <th>Status</th>
          <th class="text-center">Actions</th>
        </tr>
      </thead>

      <tbody>
        <% volunteers.forEach(v => { %>
          <tr>
            <td><%= v.project_title %></td>
            <td><%= v.description %></td>
            <td><%= v.location %></td>

            <td>
              <%= v.project_date
                ? new Date(v.project_date).toISOString().split('T')[0]
                : '' %>
            </td>

            <td><%= v.role_type %></td>
            <td><%= v.hours_committed %></td>

            <td>
              <%= v.date_to_start
                ? new Date(v.date_to_start).toISOString().split('T')[0]
                : '' %>
            </td>

            <td>
              <span class="badge
                <%= v.volunteer_status === 'Active' ? 'bg-success'
                  : v.volunteer_status === 'Completed' ? 'bg-secondary'
                  : 'bg-danger' %>">
                <%= v.volunteer_status %>
              </span>
            </td>

            <td class="text-center">
              <!-- Edit -->
              <a href="/volunteer/registration/<%= v.project_id %>"
                 class="btn btn-sm btn-outline-primary me-1">
                <i class="fa-solid fa-pen-to-square"></i> Edit
              </a>

              <!-- Delete trigger -->
              <button
                class="btn btn-sm btn-outline-danger"
                data-bs-toggle="modal"
                data-bs-target="#deleteModal"
                data-project-id="<%= v.project_id %>"
                data-project-title="<%= v.project_title %>"
              >
                <i class="fa-solid fa-trash"></i> Withdraw
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <div class="alert alert-info">
      <i class="fa-solid fa-circle-info me-2"></i>
      You have not registered for any volunteer projects yet.
    </div>
  <% } %>
</div>

<!-- DELETE CONFIRMATION MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-danger">

      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title">
          <i class="fa-solid fa-triangle-exclamation me-1"></i>
          Withdraw from Project
        </h5>
        <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <p>
          Are you sure you want to withdraw from
          <strong id="deleteProjectTitle"></strong>?
        </p>
        <p class="text-danger mb-0">
          This action cannot be undone.
        </p>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>

        <form id="deleteForm" method="POST">
          <button type="submit" class="btn btn-danger">
            <i class="fa-solid fa-trash me-1"></i> Withdraw
          </button>
        </form>
      </div>

    </div>
  </div>
</div>

<script>
  const deleteModal = document.getElementById('deleteModal');
  deleteModal.addEventListener('show.bs.modal', event => {
    const button = event.relatedTarget;
    const projectId = button.getAttribute('data-project-id');
    const projectTitle = button.getAttribute('data-project-title');

    document.getElementById('deleteProjectTitle').textContent = projectTitle;
    document.getElementById('deleteForm').action =
      `/volunteer/delete/${projectId}`;
  });
</script>

<%- include('../partials/footer') %>