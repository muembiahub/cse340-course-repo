<%- include('../partials/header') %>

<main>
  <div class="container mt-4">

    <h2 class="mb-4"><%= title %></h2>

    <% if (volunteers && volunteers.length) { %>
      <table class="table table-striped table-hover shadow-sm">
        <thead class="table-primary">
          <tr>
            <th>Project</th>
            <th>Description</th>
            <th>Location</th>
            <th>Date</th>
            <th>Role Type</th>
            <th>Hours</th>
            <th>Status</th>
          </tr>
        </thead>

        <tbody>
          <% volunteers.forEach(v => { %>
            <tr>
              <td><%= v.project_title %></td>
              <td><%= v.description %></td>
              <td><%= v.location %></td>

              <td>
                <%= v.project_date
                  ? new Date(v.project_date).toISOString().split('T')[0]
                  : '' %>
              </td>

              <td><%= v.role_type %></td>
              <td><%= v.hours_committed %></td>

              <td>
                <span class="badge
                  <%= v.volunteer_status === 'Active'
                    ? 'bg-success'
                    : v.volunteer_status === 'Completed'
                    ? 'bg-secondary'
                    : 'bg-danger' %>">
                  <%= v.volunteer_status %>
                </span>
              </td>

              
            </tr>
          <% }) %>
        </tbody>
      </table>

    <% } else { %>
      <div class="alert alert-info">
        <i class="fa-solid fa-circle-info me-2"></i>
        You have not registered for any volunteer projects yet.
      </div>
    <% } %>

  </div>
</main>
<%- include('../partials/footer') %>