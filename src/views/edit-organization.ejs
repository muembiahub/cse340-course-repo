<%- include('partials/header', { title: 'Edit Organization' }) %>

<main class="container my-5">
  <h1 class="mb-4"><%= title %></h1>

  <!-- Flash messages -->
  <% if (messages && messages.success && messages.success.length > 0) { %>
    <div class="alert alert-success d-flex align-items-center">
      <i class="fa-solid fa-circle-check me-2"></i>
      <%= messages.success %>
    </div>
  <% } %>
  <% if (messages && messages.errors && messages.errors.length > 0) { %>
    <div class="alert alert-danger d-flex align-items-center">
      <i class="fa-solid fa-triangle-exclamation me-2"></i>
      <%= messages.errors %>
    </div>
  <% } %>

  <!-- Form -->
  <form action="/edit-organizationdetails/<%= organizationDetails.organization_id %>" 
        method="POST" 
        class="styled-form needs-validation" novalidate>

    <!-- Organization Name -->
    <div class="form-group mb-3">
      <label for="name" class="form-label">
        <i class="fa-solid fa-building me-1"></i> Organization Name
      </label>
      <input type="text" id="name" name="name" 
             class="form-control" 
             value="<%= organizationDetails.name %>" 
             maxlength="150" required>
      <div class="invalid-feedback">Please enter an organization name.</div>
    </div>

    <!-- Description -->
    <div class="form-group mb-3">
      <label for="description" class="form-label">
        <i class="fa-solid fa-align-left me-1"></i> Description
      </label>
      <textarea id="description" name="description" 
                class="form-control" 
                maxlength="500" rows="4" required><%= organizationDetails.description %></textarea>
      <div class="invalid-feedback">Please provide a description.</div>
    </div>

    <!-- Contact Email -->
    <div class="form-group mb-3">
      <label for="contactEmail" class="form-label">
        <i class="fa-solid fa-envelope me-1"></i> Contact Email
      </label>
      <input type="email" id="contactEmail" name="contactEmail" 
             class="form-control" 
             maxlength="255" required 
             value="<%= organizationDetails.contact_email %>">
      <div class="invalid-feedback">Please enter a valid email address.</div>
    </div>

    <!-- Logo Filename -->
    <div class="form-group mb-3">
      <label for="logoFilename" class="form-label">
        <i class="fa-solid fa-image me-1"></i> Logo Filename
      </label>
      <input type="text" id="logoFilename" name="logoFilename" 
             class="form-control" 
             maxlength="255" required 
             value="<%= organizationDetails.logo_filename %>">
      <div class="invalid-feedback">Please provide a logo filename.</div>
    </div>

    <!-- Buttons -->
    <div class="d-flex justify-content-between mt-4">
      <button type="submit" class="btn btn-success pulse">
        <i class="fa-solid fa-check me-1"></i> Update Organization
      </button>
      <a href="/organizationdetails/<%= organizationDetails.organization_id %>" class="btn btn-secondary">
        <i class="fa-solid fa-xmark me-1"></i> Cancel
      </a>
    </div>
  </form>
</main>

<!-- Bootstrap JS + validation -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
  (function () {
    'use strict';
    const forms = document.querySelectorAll('.needs-validation');
    Array.from(forms).forEach(form => {
      form.addEventListener('submit', event => {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
  })();
</script>

<%- include('partials/footer') %>
