<%- include('partials/header', { title }) %>

<main class="container my-5">

  <!-- Page Header -->
  <div class="mb-4">
    <h1 class="mb-1">
      <i class="fa-solid fa-building me-2 text-primary"></i>
      <%= title %>
    </h1>
    <p class="text-muted mb-0">
      Organization details and associated service projects
    </p>
  </div>

  <!-- Tabs -->
  <ul class="nav nav-tabs" id="orgTabs" role="tablist">
    <li class="nav-item">
      <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#details" type="button">
        <i class="fa-solid fa-circle-info me-1"></i> Details
      </button>
    </li>

    <li class="nav-item">
      <button class="nav-link" data-bs-toggle="tab" data-bs-target="#projects" type="button">
        <i class="fa-solid fa-diagram-project me-1"></i> Projects
      </button>
    </li>

    <li class="nav-item">
      <% if (user && user.role_name === 'admin') { %>
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#edit" type="button">
          <i class="fa-solid fa-pen-to-square me-1"></i> Edit Organization
        </button>
      <% } else { %>
        <button class="nav-link disabled" type="button">
          <i class="fa-solid fa-lock me-1"></i> Edit (Admins Only)
        </button>
      <% } %>
    </li>
  </ul>

  <!-- Tab Content -->
  <div class="tab-content mt-4">

    <!-- DETAILS TAB -->
    <div class="tab-pane fade show active" id="details">
      <div class="card shadow-sm">
        <div class="card-body text-center">

          <h3 class="fw-semibold mb-3"><%= organizationDetails.name %></h3>

          <img
            src="/images/<%= organizationDetails.logo_filename %>"
            alt="<%= organizationDetails.name %> logo"
            class="img-fluid rounded mb-3"
            style="max-height:150px;"
          >

          <p>
            <strong>Description:</strong>
            <%= organizationDetails.description %>
          </p>

          <p>
            <strong>Contact:</strong>
            <a href="mailto:<%= organizationDetails.contact_email %>">
              <i class="fa-solid fa-envelope me-1"></i>
              <%= organizationDetails.contact_email %>
            </a>
          </p>

        </div>
      </div>
    </div>

    <!-- PROJECTS TAB -->
    <div class="tab-pane fade" id="projects">

      <!-- Header / Controls -->
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">
          <i class="fa-solid fa-diagram-project me-1 text-primary"></i>
          Service Projects
          <span class="badge bg-secondary ms-2" id="projectCount">
            <%= projects?.length || 0 %>
          </span>
        </h4>

        <select id="projectSort" class="form-select form-select-sm w-auto">
          <option value="title">Sort by Name</option>
          <option value="date">Sort by Date</option>
        </select>
      </div>

      <!-- Search -->
      <input
        type="text"
        id="projectSearch"
        class="form-control mb-3"
        placeholder="Search projects..."
      >

      <% if (projects && projects.length > 0) { %>
        <div class="row g-3" id="projectList">

          <% projects.forEach(project => { 
            const titleSafe = project.project_title || project.title || 'Untitled Project';
          %>
            <div
              class="col-md-6 project-item"
              data-title="<%= titleSafe.toLowerCase() %>"
              data-date="<%= project.project_date
                ? new Date(project.project_date).toISOString()
                : '' %>"
            >
              <div class="card h-100 shadow-sm border-0 <%= project.featured ? 'border-warning border-2' : '' %>">
                <div class="card-body d-flex justify-content-between align-items-start">

                  <div>
                    <h6 class="mb-1">
                      <a href="/projectsdetails/<%= project.project_id %>" class="fw-semibold text-decoration-none">
                        <i class="fa-solid fa-folder-open me-1 text-secondary"></i>
                        <%= titleSafe %>
                      </a>

                      <% if (project.featured) { %>
                        <span class="badge bg-warning text-dark ms-1">⭐ Featured</span>
                      <% } %>
                    </h6>

                    <small class="text-muted">
                      <i class="fa-solid fa-calendar-days me-1"></i>
                      <%= project.project_date
                        ? new Date(project.project_date).toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric'
                          })
                        : 'No date' %>
                    </small>
                  </div>

                  <span class="badge bg-primary rounded-pill">Project</span>

                </div>
              </div>
            </div>
          <% }) %>

        </div>
      <% } else { %>
        <div class="alert alert-info d-flex align-items-center mt-3">
          <i class="fa-solid fa-circle-info me-2"></i>
          No projects available for this organization.
        </div>
      <% } %>

    </div>

    <!-- EDIT TAB -->
    <div class="tab-pane fade" id="edit">
      <% if (user && user.role_name === 'admin') { %>
        <div class="card shadow-sm">
          <div class="card-header bg-warning text-dark">
            <i class="fa-solid fa-pen-to-square me-1"></i> Edit Organization
          </div>
          <div class="card-body">
            <%- include('partials/organization-form', {
              mode: 'edit',
              organization: organizationDetails
            }) %>
          </div>
        </div>
      <% } else { %>
        <div class="alert alert-info d-flex align-items-center mt-3">
          <i class="fa-solid fa-lock me-2"></i>
          You do not have permission to edit this organization.
        </div>
      <% } %>
    </div>

  </div>
</main>

<!-- Search / Sort Script -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  const searchInput = document.getElementById('projectSearch');
  const sortSelect = document.getElementById('projectSort');
  const projects = Array.from(document.querySelectorAll('.project-item'));
  const projectList = document.getElementById('projectList');
  const projectCount = document.getElementById('projectCount');

  function updateCount() {
    projectCount.textContent = projects.filter(p => p.style.display !== 'none').length;
  }

  function filterProjects() {
    const q = searchInput.value.toLowerCase();
    projects.forEach(p => {
      p.style.display = p.dataset.title.includes(q) ? '' : 'none';
    });
    updateCount();
  }

  function sortProjects() {
    const by = sortSelect.value;
    projects.sort((a, b) =>
      by === 'title'
        ? a.dataset.title.localeCompare(b.dataset.title)
        : new Date(b.dataset.date) - new Date(a.dataset.date)
    );
    projects.forEach(p => projectList.appendChild(p));
  }

  searchInput?.addEventListener('input', filterProjects);
  sortSelect?.addEventListener('change', sortProjects);
});
</script>

<%- include('partials/footer') %>
