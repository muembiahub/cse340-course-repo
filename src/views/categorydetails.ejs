<%- include('partials/header', { title: 'Category Details' }) %>

<main class="container my-5">

  <!-- Page Header -->
  <div class="mb-4">
    <h1 class="mb-1">
      <i class="fa-solid fa-tag me-2 text-primary"></i>
      <%= category.category_name %>
    </h1>
    <p class="text-muted mb-0">
      Projects associated with this service category
    </p>
  </div>

  <!-- Flash Messages -->
  <div class="mb-4">
    <% if (messages?.success?.length) { %>
      <div class="alert alert-success d-flex align-items-center">
        <i class="fa-solid fa-circle-check me-2"></i>
        <%= messages.success.join(', ') %>
      </div>
    <% } %>

    <% if (messages?.errors?.length) { %>
      <div class="alert alert-danger d-flex align-items-center">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>
        <%= messages.errors.join(', ') %>
      </div>
    <% } %>
  </div>

  <!-- Tabs -->
  <ul class="nav nav-tabs">
    <li class="nav-item">
      <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#details">
        <i class="fa-solid fa-circle-info me-1"></i> Details
      </button>
    </li>

    <li class="nav-item">
      <button class="nav-link" data-bs-toggle="tab" data-bs-target="#projects">
        <i class="fa-solid fa-diagram-project me-1"></i> Projects
      </button>
    </li>

    <li class="nav-item">
      <% if (user?.role_name === 'admin') { %>
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#add">
          <i class="fa-solid fa-plus me-1"></i> Add Project
        </button>
      <% } else { %>
        <button class="nav-link disabled">
          <i class="fa-solid fa-lock me-1"></i> Add Project (Admins Only)
        </button>
      <% } %>
    </li>
  </ul>

  <div class="tab-content mt-4">

    <!-- DETAILS TAB -->
    <div class="tab-pane fade show active" id="details">

      <div class="card shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <h3 class="mb-2"><%= category.category_name %></h3>
            <p class="text-muted mb-0">
              Manage and monitor projects related to this category.
            </p>
          </div>

          <% if (user?.role_name === 'admin') { %>
            <div class="d-flex gap-2">
              <button
                class="btn btn-warning"
                data-bs-toggle="modal"
                data-bs-target="#editCategoryModal"
              >
                <i class="fa-solid fa-pen-to-square me-1"></i> Edit
              </button>

              <button
                class="btn btn-danger"
                data-bs-toggle="modal"
                data-bs-target="#deleteCategoryModal"
              >
                <i class="fa-solid fa-trash me-1"></i> Delete
              </button>
            </div>
          <% } %>
        </div>
      </div>

    </div>

    <!-- PROJECTS TAB -->
    <div class="tab-pane fade" id="projects">
      <h4 class="mb-3">
        <i class="fa-solid fa-diagram-project me-1 text-primary"></i>
        Related Projects
        <span class="badge bg-secondary ms-2">
          <%= projects?.length || 0 %>
        </span>
      </h4>

      <% if (projects?.length) { %>
        <div class="row g-4">
          <% projects.forEach(project => { %>
            <div class="col-md-6 col-lg-4">
              <div class="card h-100 shadow-sm">
                <div class="card-body">
                  <h5 class="card-title">
                    <a href="/projectsdetails/<%= project.project_id %>" class="text-decoration-none">
                      <%= project.project_title || 'Untitled Project' %>
                    </a>
                  </h5>
                  <p class="mb-1"><strong>Location:</strong> <%= project.location %></p>
                  <p class="mb-1"><strong>Date:</strong>
                    <%= new Date(project.project_date).toLocaleDateString() %>
                  </p>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="alert alert-info mt-3">
          No projects linked to this category.
        </div>
      <% } %>
    </div>

    <!-- ADD PROJECT TAB -->
    <div class="tab-pane fade" id="add">
      <% if (user?.role_name === 'admin') { %>
        <%- include('partials/project-form', {
          mode: 'create',
          project: null,
          preselectedCategory: category.category_id
        }) %>
      <% } %>
    </div>

  </div>

  <!-- EDIT CATEGORY MODAL -->
  <div class="modal fade" id="editCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-md modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header bg-warning">
          <h5 class="modal-title">
            <i class="fa-solid fa-pen-to-square me-1"></i> Edit Category
          </h5>
          <button class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <%- include('partials/category-form', {
            mode: 'edit',
            category
          }) %>
        </div>
      </div>
    </div>
  </div>

  <!-- DELETE CATEGORY MODAL -->
  <div class="modal fade" id="deleteCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-danger">

        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>
            Delete Category
          </h5>
          <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <p class="mb-0">
            Are you sure you want to delete the category
            <strong><%= category.category_name %></strong>?
          </p>
          <p class="text-danger mt-2 mb-0">
            This action cannot be undone.
          </p>
        </div>

        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
          </button>

          <form
            action="/delete-category/<%= category.category_id %>"
            method="POST"
          >
            <button type="submit" class="btn btn-danger">
              <i class="fa-solid fa-trash me-1"></i> Delete
            </button>
          </form>
        </div>

      </div>
    </div>
  </div>

</main>

<%- include('partials/footer') %>