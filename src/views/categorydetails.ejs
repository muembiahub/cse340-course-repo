<%- include('partials/header', { title: 'Category Details' }) %>

<main class="container my-5">
  <h1 class="mb-4"><%= category.category_name %></h1>

  <!-- Tabs -->
  <ul class="nav nav-tabs" id="categoryTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="details-tab" data-bs-toggle="tab" data-bs-target="#details" type="button" role="tab" aria-controls="details" aria-selected="true">
        <i class="fa-solid fa-tag me-1"></i> Details
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="projects-tab" data-bs-toggle="tab" data-bs-target="#projects" type="button" role="tab" aria-controls="projects" aria-selected="false">
        <i class="fa-solid fa-diagram-project me-1"></i> Projects
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="add-tab" data-bs-toggle="tab" data-bs-target="#add" type="button" role="tab" aria-controls="add" aria-selected="false">
        <i class="fa-solid fa-plus me-1"></i> Add Project
      </button>
    </li>
  </ul>

  <!-- Tab Content -->
  <div class="tab-content mt-4" id="categoryTabsContent">
    <!-- Details Tab -->
    <div class="tab-pane fade show active" id="details" role="tabpanel" aria-labelledby="details-tab">
      <div class="card shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <h2 class="card-title mb-3"><%= category.category_name %></h2>
            <p class="card-text text-muted">Explore projects related to this category and add new ones.</p>
          </div>
          <!-- Edit Category Button -->
          <div>
            <a href="/edit-category/<%= category.category_id %>" class="btn btn-warning">
              <i class="fa-solid fa-pen-to-square me-1"></i> Edit Category
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Projects Tab -->
    <div class="tab-pane fade" id="projects" role="tabpanel" aria-labelledby="projects-tab">
      <h3 class="mb-3">Projets liés :</h3>
      <% if (projects && projects.length > 0) { %>
        <div class="row g-4">
          <% projects.forEach(project => { %>
            <div class="col-md-6 col-lg-4">
              <div class="card h-100 shadow-sm project-item">
                <div class="card-body d-flex flex-column">
                  <h5 class="card-title">
                    <a href="/projectsdetails/<%= project.project_id %>">
                      <%= project.project_title %>
                    </a>
                  </h5>
                  <p class="card-text"><strong>Description:</strong> <%= project.description %></p>
                  <p class="card-text"><strong>Location:</strong> <%= project.location %></p>
                  <p class="card-text"><strong>Date:</strong>
                    <%= new Date(project.project_date).toLocaleDateString('fr-FR', { 
                          year: 'numeric', 
                          month: 'long', 
                          day: 'numeric' 
                        }) %>
                  </p>
                  <p class="card-text mt-auto">
                    <strong>Organisation:</strong>
                    <a href="/organizationdetails/<%= project.organization_id %>">
                      <%= project.organization_name %>
                    </a>
                  </p>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="alert alert-info d-flex align-items-center mt-3">
          <i class="fa-solid fa-circle-info me-2"></i>
          Aucun projet lié à cette catégorie.
        </div>
      <% } %>
    </div>

    <!-- Add Project Tab -->
    <div class="tab-pane fade" id="add" role="tabpanel" aria-labelledby="add-tab">
      <h3 class="mb-3">Add New Project to <%= category.category_name %></h3>
      <form action="/new-project" method="POST" class="styled-form needs-validation" novalidate>
        <input type="hidden" name="category_id" value="<%= category.category_id %>">

        <div class="form-group mb-3">
          <label for="projectTitle" class="form-label">
            <i class="fa-solid fa-heading me-1"></i> Project Title
          </label>
          <input type="text" id="projectTitle" name="projectTitle" class="form-control" maxlength="150" required>
        </div>

        <div class="form-group mb-3">
          <label for="description" class="form-label">
            <i class="fa-solid fa-align-left me-1"></i> Description
          </label>
          <textarea id="description" name="description" class="form-control" maxlength="500" rows="4" required></textarea>
        </div>

        <div class="form-group mb-3">
          <label for="location" class="form-label">
            <i class="fa-solid fa-location-dot me-1"></i> Location
          </label>
          <input type="text" id="location" name="location" class="form-control" maxlength="150" required>
        </div>

        <div class="form-group mb-3">
          <label for="contactEmail" class="form-label">
            <i class="fa-solid fa-envelope me-1"></i> Contact Email
          </label>
          <input type="email" id="contactEmail" name="contactEmail" class="form-control" maxlength="255" required>
        </div>

        <button type="submit" class="btn btn-success pulse">
          <i class="fa-solid fa-check me-1"></i> Create Project
        </button>
      </form>
    </div>
  </div>
</main>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<%- include('partials/footer') %>
