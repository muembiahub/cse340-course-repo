<%- include('partials/header', { title: 'Category Details' }) %>

<main class="container my-5">

  <!-- Page Header -->
  <div class="mb-4">
    <h1 class="mb-1">
      <i class="fa-solid fa-tag me-2 text-primary"></i>
      <%= category.category_name %>
    </h1>
    <p class="text-muted mb-0">
      Projects associated with this service category
    </p>
  </div>

  <!-- Tabs -->
  <ul class="nav nav-tabs" id="categoryTabs" role="tablist">

    <li class="nav-item">
      <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#details" type="button">
        <i class="fa-solid fa-circle-info me-1"></i> Details
      </button>
    </li>

    <li class="nav-item">
      <button class="nav-link" data-bs-toggle="tab" data-bs-target="#projects" type="button">
        <i class="fa-solid fa-diagram-project me-1"></i> Projects
      </button>
    </li>

    <li class="nav-item">
      <% if (user && user.role_name === 'admin') { %>
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#add" type="button">
          <i class="fa-solid fa-plus me-1"></i> Add Project
        </button>
      <% } else { %>
        <button class="nav-link disabled" type="button">
          <i class="fa-solid fa-lock me-1"></i> Add Project (Admins Only)
        </button>
      <% } %>
    </li>

  </ul>

  <!-- Tab Content -->
  <div class="tab-content mt-4">

    <!-- DETAILS TAB -->
    <div class="tab-pane fade show active" id="details">
      <div class="card shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">

          <div>
            <h3 class="mb-2"><%= category.category_name %></h3>
            <p class="text-muted mb-0">
              View, manage, and add projects related to this category.
            </p>
          </div>

         <% if (user && user.role_name === 'admin') { %>
  <button
    type="button"
    class="btn btn-warning"
    data-bs-toggle="modal"
    data-bs-target="#editCategoryModal"
  >
    <i class="fa-solid fa-pen-to-square me-1"></i>
    Edit Category
  </button>
<% } else { %>
  <button class="btn btn-secondary" disabled>
    <i class="fa-solid fa-lock me-1"></i>
    Admins Only
  </button>
<% } %>

        </div>
      </div>
    </div>

    <!-- PROJECTS TAB -->
    <div class="tab-pane fade" id="projects">

      <h4 class="mb-3">
        <i class="fa-solid fa-diagram-project me-1 text-primary"></i>
        Related Projects
        <span class="badge bg-secondary ms-2">
          <%= projects?.length || 0 %>
        </span>
      </h4>

      <% if (projects && projects.length > 0) { %>

        <div class="row g-4">

          <% projects.forEach(project => { 
               const titleSafe = project.project_title || project.title || 'Untitled Project';
          %>
            <div class="col-md-6 col-lg-4">
              <div class="card h-100 shadow-sm">

                <div class="card-body d-flex flex-column">

                  <h5 class="card-title">
                    <a href="/projectsdetails/<%= project.project_id %>" class="text-decoration-none fw-semibold">
                      <i class="fa-solid fa-folder-open me-1 text-secondary"></i>
                      <%= titleSafe %>
                    </a>
                  </h5>

                  <p class="card-text mb-1">
                    <strong>Location:</strong> <%= project.location %>
                  </p>

                  <p class="card-text mb-1">
                    <strong>Date:</strong>
                    <%= new Date(project.project_date).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    }) %>
                  </p>

                  <p class="card-text mt-auto">
                    <strong>Organization:</strong>
                    <a href="/organizationdetails/<%= project.organization_id %>">
                      <%= project.organization_name %>
                    </a>
                  </p>

                </div>
              </div>
            </div>
          <% }) %>

        </div>

      <% } else { %>

        <div class="alert alert-info d-flex align-items-center mt-3">
          <i class="fa-solid fa-circle-info me-2"></i>
          No projects linked to this category.
        </div>

      <% } %>
    </div>

    <!-- ADD PROJECT TAB -->
    <div class="tab-pane fade" id="add">
      <h4 class="mb-3">
        <i class="fa-solid fa-plus me-1"></i>
        Add New Project to <%= category.category_name %>
      </h4>

      <%- include('partials/project-form', {
        mode: 'create',
        project: null,
        preselectedCategory: category.category_id
      }) %>
    </div>

  </div>


  <!--   -->

  <!-- Edit Category Modal -->
<div
  class="modal fade"
  id="editCategoryModal"
  tabindex="-1"
  aria-labelledby="editCategoryModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-md modal-dialog-centered">
    <div class="modal-content">

      <!-- Modal Header -->
      <div class="modal-header bg-warning text-dark">
        <h5 class="modal-title" id="editCategoryModalLabel">
          <i class="fa-solid fa-pen-to-square me-1"></i>
          Edit Category
        </h5>
        <button
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>

      <!-- Modal Body -->
      <div class="modal-body">
        <%- include('partials/category-form', {
          mode: 'edit',
          category
        }) %>
      </div>

    </div>
  </div>
</div>
</main>

<%- include('partials/footer') %>