<%- include('partials/header', { title: title }) %>

<main class="container my-5">

  <!-- Page Header -->
  <div class="mb-4">
    <h1 class="mb-1">
      <i class="fa-solid fa-diagram-project me-2 text-primary"></i>
      <%= title %>
    </h1>
    <p class="text-muted mb-0">
      Detailed information about this community service project
    </p>
  </div>

  <!-- Tabs -->
  <ul class="nav nav-tabs" id="projectTabs" role="tablist">

    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="details-tab"
        data-bs-toggle="tab" data-bs-target="#details"
        type="button" role="tab">
        <i class="fa-solid fa-circle-info me-1"></i> Details
      </button>
    </li>

    <li class="nav-item" role="presentation">
      <button class="nav-link" id="categories-tab"
        data-bs-toggle="tab" data-bs-target="#categories"
        type="button" role="tab">
        <i class="fa-solid fa-tags me-1"></i> Categories
      </button>
    </li>

    <li class="nav-item" role="presentation">
      <% if (user && user.role_name === 'admin') { %>
        <button class="nav-link" id="edit-tab"
          data-bs-toggle="tab" data-bs-target="#edit"
          type="button" role="tab">
          <i class="fa-solid fa-pen-to-square me-1"></i> Edit Project
        </button>
      <% } else { %>
        <button class="nav-link disabled" type="button" aria-disabled="true">
          <i class="fa-solid fa-lock me-1"></i> Edit (Admins Only)
        </button>
      <% } %>
    </li>

  </ul>

  <!-- Tab Content -->
  <div class="tab-content mt-4">

    <!-- Details -->
    <div class="tab-pane fade show active" id="details" role="tabpanel">
      <div class="card shadow-sm">
        <div class="card-body">

          <h3 class="card-title mb-3">
            <i class="fa-solid fa-heading me-1 text-secondary"></i>
            <%= project.project_title %>
          </h3>

          <p><strong>Description:</strong> <%= project.description %></p>
          <p><strong>Location:</strong> <%= project.location %></p>
          <p><strong>Date:</strong>
            <%= new Date(project.project_date).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            }) %>
          </p>

          <p>
            <strong>Organization:</strong>
            <a href="/organizationdetails/<%= project.organization_id %>"
               class="link-primary fw-semibold">
              <i class="fa-solid fa-building me-1"></i>
              <%= project.organization_name %>
            </a>
          </p>

        </div>
      </div>
    </div>

    <!-- Categories -->
    <div class="tab-pane fade" id="categories" role="tabpanel">
      <h4 class="mb-3">
        <i class="fa-solid fa-tags me-1 text-secondary"></i>
        Categories
      </h4>

      <% if (project.category_names?.length) { %>
        <% project.category_names.forEach((cat, i) => { %>
          <a href="/categorydetails/<%= project.category_ids[i] %>"
             class="badge bg-primary me-1 mb-1">
            <%= cat %>
          </a>
        <% }) %>
      <% } else { %>
        <div class="alert alert-info d-flex align-items-center mt-3">
          <i class="fa-solid fa-circle-info me-2"></i>
          No categories assigned to this project.
        </div>
      <% } %>
    </div>

    <!-- Edit -->
    <div class="tab-pane fade" id="edit" role="tabpanel">
      <% if (user && user.role_name === 'admin') { %>

        <div class="card shadow-sm">
          <div class="card-header bg-warning text-dark">
            <i class="fa-solid fa-pen-to-square me-1"></i>
            Edit Project
          </div>
          <div class="card-body">

            <%- include('partials/project-form', {
              mode: 'edit',
              project,
              organizations,
              categories
            }) %>

          </div>
        </div>

      <% } else { %>

        <div class="alert alert-info d-flex align-items-center mt-3">
          <i class="fa-solid fa-lock me-2"></i>
          You do not have permission to edit this project.
        </div>

      <% } %>
    </div>

  </div>

</main>

<%- include('partials/footer') %>