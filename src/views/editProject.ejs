<%- include('partials/header', { title: 'Edit Project' }) %>
<body class="bg-light">
  <div class="container mt-5">
    <div class="card shadow-lg">
      <div class="card-header bg-primary text-white d-flex align-items-center">
        <i class="fa-solid fa-pen-to-square me-2"></i>
        <h3 class="mb-0">Edit Project</h3>
      </div>
      <div class="card-body">

        <!-- Flash messages -->
        <% if (messages && messages.success && messages.success.length > 0) { %>
          <div class="alert alert-success d-flex align-items-center">
            <i class="fa-solid fa-circle-check me-2"></i>
            <%= messages.success %>
          </div>
        <% } %>
        <% if (messages && messages.errors && messages.errors.length > 0) { %>
          <div class="alert alert-danger d-flex align-items-center">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            <%= messages.errors %>
          </div>
        <% } %>

        <form action="/edit-project/<%= project.project_id %>" method="POST" class="needs-validation" novalidate>
          <!-- Title -->
          <div class="mb-3">
            <label for="title" class="form-label">
              <i class="fa-solid fa-heading me-1"></i> Title
            </label>
            <input type="text" id="title" name="title" class="form-control" 
                   value="<%= project.project_title %>" required>
            <div class="invalid-feedback">Please enter a project title.</div>
          </div>

          <!-- Description -->
          <div class="mb-3">
            <label for="description" class="form-label">
              <i class="fa-solid fa-align-left me-1"></i> Description
            </label>
            <textarea id="description" name="description" class="form-control" rows="4" required>
              <%= project.description %>
            </textarea>
            <div class="invalid-feedback">Please provide a description.</div>
          </div>

          <!-- Location -->
          <div class="mb-3">
            <label for="location" class="form-label">
              <i class="fa-solid fa-location-dot me-1"></i> Location
            </label>
            <input type="text" id="location" name="location" class="form-control" 
                   value="<%= project.location %>" required>
            <div class="invalid-feedback">Please enter a location.</div>
          </div>

          <!-- Date -->
          <div class="mb-3">
            <label for="date" class="form-label">
              <i class="fa-solid fa-calendar-days me-1"></i> Date
            </label>
            <input type="date" id="date" name="date" class="form-control" 
                   value="<%= project.project_date ? project.project_date.toISOString().split('T')[0] : '' %>" required>
            <div class="invalid-feedback">Please select a date.</div>
          </div>

          <!-- Organization -->
          <div class="mb-3">
            <label for="organizationId" class="form-label">
              <i class="fa-solid fa-building me-1"></i> Organization
            </label>
            <select id="organizationId" name="organizationId" 
                    class="form-select selectpicker" data-live-search="true" required>
              <% organizations.forEach(org => { %>
                <option value="<%= org.organization_id %>" 
                        <%= project.organization_id === org.organization_id ? 'selected' : '' %>>
                  <%= org.name %>
                </option>
              <% }) %>
            </select>
            <div class="invalid-feedback">Please select an organization.</div>
          </div>

          <!-- Categories -->
          <div class="mb-3">
            <label for="categories" class="form-label">
              <i class="fa-solid fa-tags me-1"></i> Categories
            </label>
            <select id="categories" name="categories" 
                    class="form-select selectpicker" data-live-search="true" multiple required>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.category_id %>" 
                        <%= project.category_ids.includes(cat.category_id) ? 'selected' : '' %>>
                  <%= cat.category_name %>
                </option>
              <% }) %>
            </select>
            <div class="invalid-feedback">Please select at least one category.</div>
          </div>

          <!-- Buttons -->
          <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-success">
              <i class="fa-solid fa-check me-1"></i> Update Project
            </button>
            <a href="/projectsdetails/<%= project.project_id %>" class="btn btn-secondary">
              <i class="fa-solid fa-xmark me-1"></i> Cancel
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Client-side validation script -->
  <script>
    (function () {
      'use strict';
      const forms = document.querySelectorAll('.needs-validation');
      Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
          if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
          }
          form.classList.add('was-validated');
        }, false);
      });
    })();
  </script>
</body>

<%- include('partials/footer') %>
